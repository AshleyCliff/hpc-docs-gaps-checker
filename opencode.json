{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter (host proxy)",
      "options": {
        "baseURL": "http://127.0.0.1:8317/api/v1",
        "apiKey": "none"
      },
      "models": {
        "anthropic/claude-sonnet-5": { "name": "Claude Sonnet 5" },
        "deepseek/deepseek-v3.2": { "name": "DeepSeek V3.2" }
      }
    }
  },
  "model": "openrouter-proxy/anthropic/claude-sonnet-5",

  "permission": {
    "external_directory": {
      "/inputs/**": "allow"
    },
    "edit": {
      "/inputs/**": "deny"
    }
  }
}
