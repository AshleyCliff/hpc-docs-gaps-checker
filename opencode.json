{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter (host proxy)",
      "options": {
        "baseURL": "http://127.0.0.1:8317/api/v1",
        "apiKey": "none"
      },
      "models": {
        "anthropic/claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        },
        "deepseek/deepseek-v3.2": {
          "name": "DeepSeek V3.2"
        },
        "anthropic/claude-opus-5": {
          "name": "Claude Opus 5"
        }
      }
    }
  },
  "model": "openrouter-proxy/deepseek/deepseek-v3.2",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": [
    "openrouter-proxy"
  ],
  "snapshot": false,
  "permission": {
    "external_directory": {
      "/inputs/**": "allow"
    },
    "edit": {
      "*": "allow",
      "/inputs/**": "deny"
    },
    "bash": "allow",
    "doom_loop": "allow"
  }
}