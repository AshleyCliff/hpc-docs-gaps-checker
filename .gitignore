# Workshop writes this on launch. Per Workshop's docs it must stay in the
# project directory and must not be copied or stored externally.
.workshop.lock
.workshop/*.lock

# Note: manifest.lock IS tracked - it records the resolved SHAs for a run.
# Do not add a broad *.lock rule here.

# Python
__pycache__/
*.py[cod]
.venv/

# The inputs tree lives outside this repo by design, so it needs no entry
# here. See "Layout" in AGENTS.md.

# Extractor intermediates, written flat by the `extract` action. Reproducible
# from the pinned SHAs, so they are not worth committing. The durable output is
# findings/run-<date>-<sha>/, which IS tracked. See findings/README.md.
findings/code-facts.json
findings/doc-claims.json
findings/deltas.json

# Agent run transcripts. Verbose, disposable, and superseded by the structured
# output in findings/. See findings/run-logs/README.md.
findings/run-logs/*
!findings/run-logs/README.md
